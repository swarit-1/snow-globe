{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lookout.invalid/schema/forecast_run.schema.json",
  "title": "Lookout forecast run (one viewpoint, one HRRR run)",
  "description": "Written by lookout-forecast to forecast/hrrr/<viewpoint_id>/<YYYYMMDDHH>z.json (PRD 8.3). Values are [field][forecast hour][point], in the orders of field_names, forecast_hours and points. Array lengths are checked in code (lookout_forecast.output.validate_document), since JSON Schema cannot relate them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "source", "model", "model_version", "model_version_note", "product",
    "viewpoint_id", "run_id", "run_start_utc", "run_max_fh", "run_complete", "live", "listed_utc",
    "fetch_started_utc", "fetch_finished_utc", "software", "grid", "forecast_hours", "missing_hours",
    "hours", "points", "field_names", "fields", "values", "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "lookout.forecast-run"},
    "source": {"const": "noaa-hrrr-bdp-pds"},
    "model": {"const": "hrrr-conus"},
    "model_version": {"type": ["string", "null"]},
    "model_version_note": {"type": "string"},
    "product": {"const": "wrfsfc"},
    "viewpoint_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$"},
    "run_id": {"type": "string", "pattern": "^[0-9]{10}$"},
    "run_start_utc": {"$ref": "#/$defs/hourUtc"},
    "run_max_fh": {"enum": [18, 48]},
    "run_complete": {"type": "boolean", "description": "Every hour of the run was on S3 when it was listed."},
    "live": {"type": "boolean", "description": "Processed within the live window of the run start, so availability is the S3 LastModified."},
    "listed_utc": {"$ref": "#/$defs/utc"},
    "fetch_started_utc": {"$ref": "#/$defs/utc"},
    "fetch_finished_utc": {"$ref": "#/$defs/utc"},
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookout_forecast", "eccodes"],
      "properties": {
        "lookout_forecast": {"type": "string"},
        "eccodes": {"type": "string"}
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nx", "ny", "lat1", "lon1", "lad", "lov", "latin1", "latin2", "dx", "dy",
                   "radius_m", "scanning_mode", "index_order"],
      "properties": {
        "type": {"const": "lambert_conformal_conic"},
        "nx": {"type": "integer", "minimum": 1},
        "ny": {"type": "integer", "minimum": 1},
        "lat1": {"type": "number"},
        "lon1": {"type": "number"},
        "lad": {"type": "number"},
        "lov": {"type": "number"},
        "latin1": {"type": "number"},
        "latin2": {"type": "number"},
        "dx": {"type": "number", "exclusiveMinimum": 0},
        "dy": {"type": "number", "exclusiveMinimum": 0},
        "radius_m": {"type": "number", "exclusiveMinimum": 0},
        "scanning_mode": {"type": "integer"},
        "index_order": {"type": "string"}
      }
    },
    "forecast_hours": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 48},
      "uniqueItems": true
    },
    "missing_hours": {
      "type": "array",
      "description": "Hours that were asked for (up to the requested max forecast hour) but not on S3 when listed (nothing stored for them). The run's state marker records the same list.",
      "items": {"type": "integer", "minimum": 0, "maximum": 48},
      "uniqueItems": true
    },
    "hours": {"type": "array", "items": {"$ref": "#/$defs/hour"}},
    "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}},
    "field_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9]+:[^:]+$"}
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/field"}
    },
    "values": {
      "type": "array",
      "description": "[field][forecast hour][point]; null where the GRIB bitmap marks the cell missing, the point is outside the grid, or the field was not in that hour's inventory.",
      "items": {
        "type": "array",
        "items": {"type": "array", "items": {"type": ["number", "null"]}}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "hourUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$"
    },
    "lagsByMethod": {
      "type": "object",
      "description": "Logged lags by method: live (the worker, while the run was new) or survey (lookout-forecast lag-survey --log, from S3 listings of past runs).",
      "propertyNames": {"enum": ["live", "survey"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "byteRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "message", "start", "end", "bytes", "terrain_only"],
      "properties": {
        "field": {"type": "string"},
        "message": {"type": "integer", "minimum": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 1},
        "terrain_only": {"type": "boolean", "description": "Fetched only to fill model_terrain_m; not in field_names."}
      }
    },
    "hour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fh", "valid_time_utc", "url", "idx_url", "grib_size_bytes", "grib_last_modified_utc",
                   "idx_last_modified_utc", "availability_utc", "availability_source", "availability_model",
                   "lag_s", "fetched_utc", "byte_ranges", "requests", "bytes_downloaded", "fields_missing_from_idx"],
      "properties": {
        "fh": {"type": "integer", "minimum": 0, "maximum": 48},
        "valid_time_utc": {"$ref": "#/$defs/hourUtc"},
        "url": {"type": "string", "pattern": "^https://noaa-hrrr-bdp-pds\\.s3\\.amazonaws\\.com/hrrr\\.[0-9]{8}/conus/hrrr\\.t[0-9]{2}z\\.wrfsfcf[0-9]{2}\\.grib2$"},
        "idx_url": {"type": "string", "pattern": "\\.grib2\\.idx$"},
        "grib_size_bytes": {"type": "integer", "minimum": 1},
        "grib_last_modified_utc": {"$ref": "#/$defs/utc"},
        "idx_last_modified_utc": {"$ref": "#/$defs/utc"},
        "availability_utc": {"$ref": "#/$defs/utc"},
        "availability_source": {"description": "live-s3-lastmodified: a live run's S3 LastModified (the later of GRIB2 and .idx). modeled: an archived run, run start + the lag model. archived-s3-lastmodified (since lookout-forecast 0.2.0): an archived run whose own S3 stamps are later than the model, so they are the availability (availability_model.s3_floor_utc).", "enum": ["live-s3-lastmodified", "modeled", "archived-s3-lastmodified"]},
        "availability_model": {
          "description": "How an archived hour's availability was computed when the file was written (null for live hours): the lag model, and (since 0.2.0) the floor its own S3 stamps set. lookout_forecast.availability.select_stored_run recomputes the model from the current lag log and applies the same floor.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "lag_s", "samples", "min_samples"],
              "properties": {
                "method": {
                  "description": "p95-cycle-hour: p95 of the lags logged for this cycle hour and forecast hour; p95-forecast-hour-or-cycle-max: the later of the p95 over all cycles and the largest lag logged for this cycle and hour; conservative-fallback: 120 min, or that largest lag if later. Logged lags are live and (since lookout-forecast 0.2.0, D-027) survey lags from lookout-forecast lag-survey --log; samples_by_method counts them apart. p95-of-logged-live-lags and default-forecast-md were written by the first build (2026-11-19, pooled p95 or the forecast.md typical lags) and stay valid for old files.",
                  "enum": ["p95-cycle-hour", "p95-forecast-hour-or-cycle-max", "conservative-fallback", "p95-of-logged-live-lags", "default-forecast-md"]
                },
                "lag_s": {"type": "number", "minimum": 0},
                "samples": {"type": "integer", "minimum": 0, "description": "Lags logged (live and survey) for this cycle hour and forecast hour. Files written by lookout-forecast 0.1.0 counted live lags only."},
                "samples_by_method": {"$ref": "#/$defs/lagsByMethod", "description": "samples split by how each lag was logged (absent from files written by 0.1.0)."},
                "pooled_samples": {"type": "integer", "minimum": 0, "description": "Lags logged (live and survey) for this forecast hour over all cycles."},
                "pooled_samples_by_method": {"$ref": "#/$defs/lagsByMethod", "description": "pooled_samples split by how each lag was logged (absent from files written by 0.1.0)."},
                "min_samples": {"type": "integer", "minimum": 1},
                "s3_floor_utc": {"description": "The earliest the hour can have been usable by its own S3 stamps: the later of grib_last_modified_utc and idx_last_modified_utc, counting only stamps within 24 h of the run start (the GRIB2 stamp + 300 s when only it counts); null when neither counts. availability_utc is never before it (absent from files written by 0.1.0).", "oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
                "s3_stamps_ignored": {"description": "Stamps more than 24 h after the run start (rewritten objects), not used for the floor (absent from files written by 0.1.0).", "type": "array", "uniqueItems": true, "items": {"enum": ["grib", "idx"]}}
              }
            }
          ]
        },
        "lag_s": {"type": "number", "description": "availability_utc - run start, seconds"},
        "fetched_utc": {"$ref": "#/$defs/utc"},
        "byte_ranges": {"type": "array", "items": {"$ref": "#/$defs/byteRange"}},
        "requests": {
          "type": "array",
          "description": "The Range requests actually made: [start, end], inclusive (adjacent messages merged).",
          "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false, "minItems": 2}
        },
        "bytes_downloaded": {"type": "integer", "minimum": 0},
        "fields_missing_from_idx": {"type": "array", "items": {"type": "string"}}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "lat", "lon", "i", "j", "cell_lat", "cell_lon", "model_terrain_m",
                   "distance_km", "azimuth_deg", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["camera", "ray", "landmark", "neighborhood"]},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "i": {"type": ["integer", "null"], "minimum": 0},
        "j": {"type": ["integer", "null"], "minimum": 0},
        "cell_lat": {"type": ["number", "null"]},
        "cell_lon": {"type": ["number", "null"]},
        "model_terrain_m": {"type": ["number", "null"], "description": "HGT:surface at the cell, m above MSL (HRRR's smoothed terrain)."},
        "distance_km": {"type": "number", "minimum": 0},
        "azimuth_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 360},
        "name": {"type": ["string", "null"]}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shortName", "name", "typeOfLevel", "level", "units", "datum", "datum_evidence", "grib",
                   "uvRelativeToGrid", "description"],
      "properties": {
        "shortName": {"type": "string"},
        "name": {"type": "string"},
        "typeOfLevel": {"type": "string"},
        "level": {"type": "integer"},
        "units": {"type": "string"},
        "datum": {"enum": ["m above MSL", "m above ground", "n/a"]},
        "datum_evidence": {"type": "string", "minLength": 10},
        "grib": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discipline", "parameterCategory", "parameterNumber", "typeOfFirstFixedSurface"],
          "properties": {
            "discipline": {"type": "integer"},
            "parameterCategory": {"type": "integer"},
            "parameterNumber": {"type": "integer"},
            "typeOfFirstFixedSurface": {"type": "integer"}
          }
        },
        "uvRelativeToGrid": {"type": ["integer", "null"], "enum": [0, 1, null]},
        "description": {"type": "string"}
      }
    }
  }
}
