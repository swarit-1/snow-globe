# Secrets
.env
.env.*
!.env.example

# Never commit voice fixtures, camera frames, plates, thumbnails or traces (PRD §9.1)
fixtures/audio/
data/frames/
data/archive/
data/plates/
data/thumbs/
traces/
*.wav
*.caf
*.m4a

# Build output
target/
node_modules/
dist/
.venv/
__pycache__/
.DS_Store
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Terraform: local state and plans can hold secrets; the lock file (.terraform.lock.hcl) is committed
.terraform/
*.tfstate*
*.tfplan
crash.log

# Headless renderer test output
test-results/
playwright-report/

# Forecast downloads belong in $LOOKOUT_DATA_DIR/cache, never in the repo
*.grib2
*.grib2.*
