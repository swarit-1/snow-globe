{
  "name": "@snow-globe/overlay",
  "version": "0.1.0",
  "description": "Snow Globe overlay web layer (PRD sections 5 and 10.3): states, chips, caption, the core-to-webview message protocol and the webview paint gate, framework-free TypeScript, with a key-mash stress harness run in headless Chromium.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./overlay/index.ts",
    "./protocol.schema.json": "./protocol.schema.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "build": "node scripts/build.ts",
    "preview": "node scripts/preview.ts",
    "stress": "node scripts/stress.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
